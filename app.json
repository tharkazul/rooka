{
  "expo": {
    "name": "Rooka",
    "slug": "spark-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rooka",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "io.rooka.app",
      "infoPlist": {
        "CFBundleDisplayName": "Rooka",
        "NSCameraUsageDescription": "Rooka requires camera access to capture physique check-in photos and coach avatars.",
        "NSMicrophoneUsageDescription": "Rooka requires microphone access for voice coaching notes and audio logs.",
        "NSPhotoLibraryUsageDescription": "Rooka requires photo library access to choose workout and progress photos.",
        "NSLocationWhenInUseUsageDescription": "Rooka requires location access to track outdoor running, cycling, and GPS activity routes.",
        "NSHealthShareUsageDescription": "Rooka needs access to read your workouts, heart rate, and activity metrics.",
        "NSHealthUpdateUsageDescription": "Rooka needs permission to save scheduled workouts to your Apple Watch and Apple Health.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": [],
        "com.apple.developer.applesignin": [
          "Default"
        ]
      }
    },
    "android": {
      "package": "io.rooka.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDs1Qr1gvD4mIKsZi5Kwkrg5QbT95jkJOk"
        }
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./assets/images/splash-icon-black.png",
          "dark": {
            "backgroundColor": "#0F172A",
            "image": "./assets/images/splash-icon-update.png"
          },
          "imageWidth": 76
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.226225996905-cmhh8e7hdon643oliukl5bl7vta26hf6"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eb8027ec-2138-4891-a3a4-684be50bfbdb"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/eb8027ec-2138-4891-a3a4-684be50bfbdb"
    }
  }
}